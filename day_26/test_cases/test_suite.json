{
  "test_suite_name": "Comprehensive Agent Prompt Test Suite",
  "version": "1.0",
  "description": "Complete test suite covering common scenarios, edge cases, and error handling",
  "test_cases": [
    {
      "id": "search_001",
      "category": "search",
      "scenario": "common",
      "input": "Search for Python documentation",
      "expected": {
        "contains": "documentation",
        "tool": "search",
        "min_length": 10,
        "max_response_time": 5
      },
      "description": "Basic search query for documentation"
    },
    {
      "id": "search_002",
      "category": "search",
      "scenario": "common",
      "input": "Find information about machine learning",
      "expected": {
        "contains": "information",
        "tool": "search",
        "min_length": 10
      },
      "description": "General information search"
    },
    {
      "id": "calc_001",
      "category": "calculator",
      "scenario": "common",
      "input": "Calculate 25 * 4",
      "expected": {
        "contains": "100",
        "tool": "calculator",
        "exact_match": "100"
      },
      "description": "Basic multiplication"
    },
    {
      "id": "calc_002",
      "category": "calculator",
      "scenario": "common",
      "input": "What is 156 + 89?",
      "expected": {
        "contains": "245",
        "tool": "calculator",
        "exact_match": "245"
      },
      "description": "Basic addition"
    },
    {
      "id": "calc_003",
      "category": "calculator",
      "scenario": "edge_case",
      "input": "Calculate 0 / 5",
      "expected": {
        "contains": "0",
        "tool": "calculator",
        "exact_match": "0"
      },
      "description": "Division with zero numerator"
    },
    {
      "id": "calc_004",
      "category": "calculator",
      "scenario": "error",
      "input": "Calculate 10 / 0",
      "expected": {
        "contains": "error",
        "tool": "calculator",
        "error_handling": true
      },
      "description": "Division by zero - should handle error gracefully"
    },
    {
      "id": "api_001",
      "category": "api",
      "scenario": "common",
      "input": "Get user data for ID 12345",
      "expected": {
        "contains": "data",
        "tool": "api_call",
        "min_length": 5
      },
      "description": "Basic API data retrieval"
    },
    {
      "id": "api_002",
      "category": "api",
      "scenario": "edge_case",
      "input": "Get user data for ID 0",
      "expected": {
        "tool": "api_call",
        "error_handling": true
      },
      "description": "API call with edge case ID"
    },
    {
      "id": "multi_001",
      "category": "multi_step",
      "scenario": "common",
      "input": "Search for the price of Bitcoin and calculate 5 times that amount",
      "expected": {
        "tools": ["search", "calculator"],
        "min_length": 20
      },
      "description": "Multi-step task requiring multiple tools"
    },
    {
      "id": "text_001",
      "category": "text_generation",
      "scenario": "common",
      "input": "Explain what AI is in simple terms",
      "expected": {
        "contains": "artificial intelligence",
        "max_words": 100,
        "min_words": 20
      },
      "description": "Text generation with constraints"
    },
    {
      "id": "text_002",
      "category": "text_generation",
      "scenario": "common",
      "input": "List 5 programming languages",
      "expected": {
        "count": 5,
        "format": "list"
      },
      "description": "Structured list generation"
    },
    {
      "id": "edge_001",
      "category": "edge_case",
      "scenario": "edge_case",
      "input": "",
      "expected": {
        "error_handling": true,
        "contains": "provide"
      },
      "description": "Empty input - should prompt for input"
    },
    {
      "id": "edge_002",
      "category": "edge_case",
      "scenario": "edge_case",
      "input": "a",
      "expected": {
        "min_length": 5
      },
      "description": "Single character input"
    },
    {
      "id": "edge_003",
      "category": "edge_case",
      "scenario": "edge_case",
      "input": "Calculate the meaning of life",
      "expected": {
        "error_handling": true
      },
      "description": "Ambiguous calculation request"
    },
    {
      "id": "error_001",
      "category": "error_handling",
      "scenario": "error",
      "input": "Search for @#$%^&*()",
      "expected": {
        "tool": "search",
        "error_handling": true
      },
      "description": "Special characters in search"
    },
    {
      "id": "error_002",
      "category": "error_handling",
      "scenario": "error",
      "input": "Calculate abc + def",
      "expected": {
        "error_handling": true,
        "contains": "invalid"
      },
      "description": "Invalid calculation input"
    },
    {
      "id": "complex_001",
      "category": "complex",
      "scenario": "common",
      "input": "Search for Python tutorials, then calculate how many hours it takes to complete 10 tutorials if each takes 2.5 hours",
      "expected": {
        "tools": ["search", "calculator"],
        "contains": "25",
        "min_length": 30
      },
      "description": "Complex multi-step reasoning"
    },
    {
      "id": "context_001",
      "category": "context",
      "scenario": "common",
      "input": "What did I just ask you?",
      "expected": {
        "context_aware": true,
        "min_length": 10
      },
      "description": "Context awareness test"
    },
    {
      "id": "format_001",
      "category": "formatting",
      "scenario": "common",
      "input": "Format this as JSON: name is John, age is 30",
      "expected": {
        "format": "json",
        "contains": "John"
      },
      "description": "Output formatting test"
    },
    {
      "id": "perf_001",
      "category": "performance",
      "scenario": "common",
      "input": "Calculate 999999 * 888888",
      "expected": {
        "tool": "calculator",
        "max_response_time": 3,
        "contains": "888887111112"
      },
      "description": "Large number calculation performance"
    }
  ]
}
